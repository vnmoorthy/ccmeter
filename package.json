{
  "name": "ccmeter",
  "version": "0.3.0",
  "description": "Local-first spend & cache-efficiency dashboard for Claude Code. Reads ~/.claude/projects, tells you exactly what's costing you.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "cli",
    "dashboard",
    "cost",
    "tokens",
    "cache",
    "observability",
    "metering"
  ],
  "homepage": "https://github.com/vnmoorthy/ccmeter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vnmoorthy/ccmeter.git"
  },
  "bugs": {
    "url": "https://github.com/vnmoorthy/ccmeter/issues"
  },
  "license": "MIT",
  "author": "ccmeter contributors",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "ccmeter": "bin/ccmeter.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:cli",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config src/web/vite.config.ts",
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:web": "vite --config src/web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "asciichart": "^1.5.25",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "lucide-react": "^0.460.0",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
